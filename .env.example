# Copy to .env for local development, or provide these values through a secret manager.
# Never commit real values. `bun run local:setup` generates isolated dev credentials.
NODE_ENV=development
APP_URL=http://127.0.0.1:4310
DATABASE_URL=postgresql://goalie:CHANGE_ME@127.0.0.1:54329/goalie
OIDC_ISSUER=http://127.0.0.1:5558/dex
OIDC_CLIENT_ID=goalie
OIDC_CLIENT_SECRET=CHANGE_ME
AUTH_BOOTSTRAP_EMAIL=goalie-admin@example.test

# Production requires HTTPS for APP_URL and OIDC_ISSUER; do not use a development bypass.
# Configure the CA files required by your deployment when PostgreSQL or OIDC uses a private CA:
# NODE_EXTRA_CA_CERTS=/run/secrets/company-ca.pem
# DB_CA_FILE=/run/secrets/postgres-ca.pem

# OpenJev assistance is disabled unless explicitly enabled. Remote HTTPS requires a matching
# trusted origin; HTTP loopback fixtures require an explicit port and may omit that setting.
OPENJEV_ENABLED=false
OPENJEV_BASE_URL=
OPENJEV_TRUSTED_ORIGIN=
OPENJEV_API_KEY_FILE=
OPENJEV_MODEL=openjev-latest
OPENJEV_TIMEOUT_MS=30000
