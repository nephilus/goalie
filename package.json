{
  "name": "goalie",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "bun --env-file=.env node_modules/@react-router/dev/bin.cjs dev --host 127.0.0.1 --port 4310",
    "build": "bun --no-env-file node_modules/@react-router/dev/bin.cjs build",
    "start": "bun --no-env-file node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "db:migrate": "bun --env-file=.env scripts/migrate.ts",
    "db:seed": "bun --env-file=.env scripts/seed.ts",
    "db:seed-work": "bun --env-file=.env scripts/seed-work.ts",
    "mcp": "node --env-file-if-exists=.env --import tsx scripts/mcp.ts",
    "local:setup": "tsx scripts/local-setup.ts",
    "db:start": "tsx scripts/pg0.ts",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "5.2.2",
    "lucide-react": "1.47.0",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bcryptjs": "3.0.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
